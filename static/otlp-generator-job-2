apiVersion: batch/v1
kind: Job
metadata:
  name: otlp-generator-job-2
  namespace: monitoring
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: python-generator
          image: python:3.11-slim
          command: ["python3", "/app/send_metric.py"]
          args: ["--count", "40", "--interval", "0.5"]
          volumeMounts:
            - name: script-volume
              mountPath: /app
      volumes:
        - name: script-volume
          configMap:
            name: otlp-generator-script-2
